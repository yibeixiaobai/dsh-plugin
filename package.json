{
  "name": "dsh-social-publisher",
  "version": "0.2.0",
  "description": "通用社媒自动化内容生产与发布插件（公众号/知乎等多平台）：选题查重 → 智能撰写排版 → AI 配图 → 草稿发布 → 自动核验",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "pipeline/*.py",
    "runtime/**/*.py",
    "runtime/**/*.md",
    "runtime/**/*.jpg",
    "assets",
    "cordis.patch.yml",
    "launch-dsh.ps1",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh",
    "social",
    "publisher",
    "media",
    "wechat",
    "gzh",
    "zhihu"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "puppeteer-core": "^25.10.0"
  }
}
